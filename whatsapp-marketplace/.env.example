# Claude
ANTHROPIC_API_KEY=sk-ant-...
MARKETPLACE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (chat-style traffic usually does well at low)
MARKETPLACE_EFFORT=low

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any string you choose; paste the same value into the webhook config in the Meta dashboard
WHATSAPP_VERIFY_TOKEN=change-me
# App secret (App settings -> Basic), used to verify X-Hub-Signature-256 on webhook POSTs
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Marketplace
MARKETPLACE_DB_PATH=marketplace.db
MARKETPLACE_CURRENCY=USD
